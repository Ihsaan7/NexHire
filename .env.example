# Runtime mode. Vercel sets this to "production" automatically.
NODE_ENV=development

# Local server/build port. Vercel manages ports automatically.
PORT=8080

# Vite public base path. Use "/" when the frontend is deployed at its own domain.
BASE_PATH=/

# API log verbosity: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Backend project: artifacts/api-server
# Add these to the backend Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string used for application data, quotas, and sync state.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key

# Clerk publishable key for the same production Clerk instance used by the frontend.
CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key

# Clerk secret key for backend authentication.
CLERK_SECRET_KEY=sk_live_your_secret_key

# Strong random secret required in the Authorization header for scheduled sync routes.
CRON_SECRET=replace_with_a_long_random_secret

# Exact HTTPS frontend origin allowed by backend CORS; do not include a trailing slash or path.
PRODUCTION_ORIGIN=https://your-frontend-project.vercel.app

# Optional USD-to-PKR conversion rate. Defaults to 278 when omitted.
USD_TO_PKR=278

# Optional monthly-hours assumption used for hourly pay estimates. Defaults to 80.
ASSUMED_HOURS_PER_MONTH=80

# ---------------------------------------------------------------------------
# Frontend project: artifacts/job-aggregator
# Add these to the frontend Vercel project's Environment Variables.
# VITE_ values are embedded into the browser bundle and must not contain secrets.
# ---------------------------------------------------------------------------

# Clerk publishable key from the same production Clerk instance used by the backend.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key

# Public URL of the backend Clerk proxy endpoint.
VITE_CLERK_PROXY_URL=https://your-api-project.vercel.app/api/__clerk

# Public backend origin used by the generated API client; omit a trailing slash.
VITE_API_BASE_URL=https://your-api-project.vercel.app

# ---------------------------------------------------------------------------
# Optional workspace-only configuration
# ---------------------------------------------------------------------------

# PostgreSQL URL used only by the shared @workspace/db package.
# The current application runtime stores its main data in MongoDB.
DATABASE_URL=postgresql://username:password@host.example/database

# Replit-only development variables referenced by local tooling.
# Do not add these to either Vercel project.
# REPL_ID=
# REPLIT_DEV_DOMAIN=