# Runtime
NODE_ENV=development
PORT=8080
BASE_PATH=/
LOG_LEVEL=info

# API server — required
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database
GEMINI_API_KEY=replace-with-gemini-api-key
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CRON_SECRET=replace-with-random-cron-secret

# API server — required in production
PRODUCTION_ORIGIN=https://your-production-domain.example

# Frontend Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PROXY_URL=
VITE_API_BASE_URL=

# Optional business defaults
USD_TO_PKR=278
ASSUMED_HOURS_PER_MONTH=80

# Shared workspace database package
DATABASE_URL=postgresql://username:password@host.example/database

# Optional session integrations
SESSION_SECRET=replace-with-random-session-secret

# Replit supplies this automatically; do not set it locally.
# REPL_ID=
# REPLIT_DEV_DOMAIN=